# Postgres pooled (Neon o Supabase). Usato da Prisma a runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Connessione diretta, senza pooler, per le migration. Se non usi un pooler, copia DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Token Vercel Blob. Lo crea Vercel quando colleghi uno store Blob al progetto.
BLOB_READ_WRITE_TOKEN=""

# Anthropic. Il nome del modello vision sta solo qui, mai nel client.
ANTHROPIC_API_KEY=""
VLM_MODEL="claude-sonnet-4-5"

# Chiave privata SerpApi. Il server la manda come parametro api_key.
SERPAPI_API_KEY=""

# Opzionale. POST JSON a ogni ricerca che ha un lead.
LEAD_WEBHOOK_URL=""

# Link per la CTA "Parla con Aftercore".
CALENDAR_URL=""

# Password unica della pagina /admin.
ADMIN_PASSWORD=""

# Tetto di ricerche per giorno UTC, tutti gli utenti.
DAILY_SEARCH_CAP="100"

# Bearer token del cron Vercel che cancella le immagini dopo 30 giorni.
CRON_SECRET=""

# Sale per l'hash degli IP. Stringa lunga e casuale.
IP_HASH_SALT=""
